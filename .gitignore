@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Playfair+Display:wght@600;700;800&display=swap');:root{  --ink:#10221f; --cream:#f5f1e8; --paper:#fffdf8; --gold:#d5a72a;  --green:#0c3d31; --deep:#06271f; --red:#a83a2a; --muted:#61706b;}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:"DM Sans",system-ui,sans-serif;line-height:1.7}a{color:inherit}.container{width:min(1120px,92%);margin:auto}.site-header{position:absolute;top:0;left:0;right:0;z-index:5;color:white;background:linear-gradient(180deg,rgba(0,0,0,.55),transparent)}.nav{display:flex;justify-content:space-between;align-items:center;padding:22px 0}.brand{font-weight:800;letter-spacing:.12em;text-decoration:none}.brand span{color:#f1c84a}.nav-links{display:flex;gap:24px;font-size:.9rem}.nav-links a{text-decoration:none;opacity:.9}.hero{min-height:88vh;display:flex;align-items:end;position:relative;background:linear-gradient(90deg,rgba(0,0,0,.76),rgba(0,0,0,.24)),url("images/president-bugimbi-ahmed-kinnawa.jpg") center/cover no-repeat;color:white}.hero-content{padding:150px 0 90px}.eyebrow{font-size:.78rem;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--gold)}.hero h1{font:800 clamp(2.5rem,6vw,5.7rem)/1.03 "Playfair Display",serif;max-width:850px;margin:16px 0}.hero-tagline{font:700 clamp(1.1rem,2vw,1.6rem) "Playfair Display",serif}.hero-copy{max-width:680px;font-size:1.05rem;color:#eee}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.button{display:inline-block;padding:13px 20px;border-radius:999px;text-decoration:none;font-weight:700}.primary{background:var(--gold);color:#162116}.ghost{border:1px solid rgba(255,255,255,.6);color:white}.stats{background:var(--deep);color:white}.stat-grid{display:grid;grid-template-columns:repeat(4,1fr)}.stat-grid div{padding:26px 18px;border-right:1px solid rgba(255,255,255,.12)}.stat-grid strong,.stat-grid span{display:block}.stat-grid strong{font-size:1.45rem;color:#f1c84a}.stat-grid span{font-size:.85rem;color:#cbd8d3}.section{padding:96px 0}.section h2{font:800 clamp(2rem,4vw,3.7rem)/1.08 "Playfair Display",serif;margin:10px 0 24px}.section p{max-width:760px}.split{display:grid;grid-template-columns:1.35fr .65fr;gap:70px;align-items:center}.quote-card{background:var(--cream);padding:42px;border-left:6px solid var(--gold)}.quote-card p{font:700 1.5rem/1.35 "Playfair Display",serif}.quote-card span{color:var(--muted);font-size:.9rem}.dark{background:var(--deep);color:white}.lead{font-size:1.15rem;color:#d6e1dd}.heritage-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:40px}.heritage-card{padding:28px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);border-radius:16px}.heritage-card span{font-size:2rem}.heritage-card h3{margin:10px 0 3px}.heritage-card p{color:#c6d4cf;font-size:.9rem;margin:0}.media-story{display:grid;grid-template-columns:1.1fr .9fr;gap:70px;align-items:center}.portrait-card{background:var(--cream);padding:12px;border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,.1)}.portrait-card img{width:100%;display:block;border-radius:12px;max-height:600px;object-fit:cover}.portrait-card div{padding:15px 8px 7px}.portrait-card strong,.portrait-card span{display:block}.portrait-card span{color:var(--muted);font-size:.85rem}.accent{background:#eadfbd}.tourism-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:38px}.tourism-grid div{padding:26px;background:rgba(255,255,255,.55);border-radius:16px}.tourism-grid strong,.tourism-grid span{display:block}.tourism-grid strong{font-size:1.2rem}.project{display:grid;grid-template-columns:1.2fr .8fr;gap:70px;align-items:center}.project-number{font:800 clamp(2.8rem,6vw,5rem)/1 "Playfair Display",serif;color:var(--red)}.project-card{background:var(--green);color:white;padding:38px;border-radius:22px}.project-card span{display:block;color:#e9c54d;font-size:.8rem;letter-spacing:.14em;font-weight:800;margin-bottom:18px}.project-card strong{display:block;font:700 1.65rem/1.25 "Playfair Display",serif;margin:10px 0}.lnd{background:linear-gradient(135deg,#08382c,#0d5945);color:white;text-align:center}.lnd-inner{display:flex;flex-direction:column;align-items:center}.lnd-title{font:800 clamp(1.6rem,3vw,2.6rem)/1.15 "Playfair Display",serif;color:#f1c84a}.flow{display:flex;align-items:center;gap:12px;flex-wrap:wrap;justify-content:center;margin-top:28px}.flow span{padding:10px 14px;border:1px solid rgba(255,255,255,.22);border-radius:999px;font-weight:700;font-size:.85rem}.flow b{color:#f1c84a}.vision{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:35px 0}.vision div{padding:28px;background:var(--cream);border-radius:16px}.vision strong{font:800 1.5rem/1.1 "Playfair Display",serif}.center-note{margin:35px auto 0;text-align:center}.support{background:#0b2f26;color:white}.support-inner{text-align:center}.support-inner>p:not(.eyebrow){margin-left:auto;margin-right:auto;color:#d6e1dd}.support-links{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:40px 0}.support-links a{padding:28px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:16px;text-decoration:none}.support-links span,.support-links strong,.support-links small{display:block}.support-links span{font-size:2rem}.support-links strong{font-size:1.1rem;margin-top:8px}.support-links small{color:#b9cbc5}.contact{display:flex;flex-direction:column;gap:3px;color:#c6d6d1}footer{background:#041a15;color:#9db1aa;padding:35px 0}footer span,footer em{display:block;margin-top:5px;font-size:.85rem}footer em{color:#d6b84e}@media(max-width:800px){  .nav-links{display:none}  .hero{min-height:82vh}  .hero-content{padding:130px 0 55px}  .stat-grid{grid-template-columns:repeat(2,1fr)}  .stat-grid div:nth-child(2){border-right:0}  .split,.media-story,.project{grid-template-columns:1fr;gap:35px}  .heritage-grid{grid-template-columns:repeat(2,1fr)}  .tourism-grid{grid-template-columns:repeat(2,1fr)}  .vision,.support-links{grid-template-columns:1fr}}@media(max-width:500px){  .section{padding:70px 0}  .heritage-grid,.tourism-grid{gridtemplate-columns:1fr}  .hero h1{font-size:2.65rem
